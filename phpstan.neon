includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    phpVersion: 80400
    paths:
        - src
        - config
        - database
        - tests
    # The package's own config directory (Larastan defaults to the Testbench
    # skeleton's config_path(), where env() calls are allowed).
    configDirectories:
        - %rootDir%/../../../config
    # Types `$this` in Pest hook/test closures as FeatureTestCase (see the stub).
    stubFiles:
        - tests/phpstan/pest-functions.stub
